# =====================================================
# LeadDesk Mini-CRM Environment Configuration
# Copy this file to .env and adjust variables as needed
# =====================================================

# Application Environment
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_NAME=leaddesk_db

# Redis Configuration (BullMQ queues)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_dev_access_secret_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_dev_refresh_secret_min_32_characters_long_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting (Throttler for public endpoint)
THROTTLE_TTL=60000
THROTTLE_LIMIT=5

# Lead Automation Settings
OVERDUE_HOURS_THRESHOLD=24

# Frontend API Base URL
VITE_API_URL=http://localhost:4000/api

